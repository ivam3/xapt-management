#!/data/data/com.termux/files/usr/bin/bash
IFS=$'\n\t'
APP="${PREFIX}/share/applications/xapt"

echo "Cloning xapt-management ..."
rm -rf "$APP"
if ! git clone --quiet https://github.com/ivam3/xapt-management "$APP"; then
  echo -e "\e[31mE:\e[0m xapt-management clone failed ... \e[33mAborting.\e[0m"
  exit 1
fi

if [[ -d "$APP/.deb/img" ]]; then
  cp -a "$APP/.deb/img" "$APP/img"
fi
rm -rf "$APP/.deb"
chmod 751 -R "$APP"

echo "Installing Python requirements ..."
python3 -m pip --no-color --quiet --no-cache-dir install -r "$APP/requirements.txt" || true

echo "[*] xapt-management installation finished."
echo "[*] Run 'xapt' to launch it."

# ==============================
# INSTALLING SCRIPT FIXER
# ==============================
echo "[*] Installing script fixer..."
fixerURL="https://raw.githubusercontent.com/ivam3/i-Haklab/master/.deb/home/.local/bin/fixer"
if curl -fsSL "$fixerURL" -o "${PREFIX}/bin/fixer"; then
    chmod 750 "${PREFIX}/bin/fixer"
    echo "[➡] Run 'fixer' to fix any possible issue."
else
    echo "[!] Could not download the optional fixer."
fi

echo "[📢] Help: https://t.me/Ivam3_Bot"
echo "[💡] @Ivam3: thank you for using this package."
